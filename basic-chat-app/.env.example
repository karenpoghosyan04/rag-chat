# Choose "gemini" for the free developer tier or "openai" for OpenAI.
# Use a multimodal model if you want questions about figures and charts.
LLM_PROVIDER=gemini

# Create a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional alternative provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings run locally by default, so PDF indexing does not consume API quota.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
# Alternatives: EMBEDDING_PROVIDER=gemini or EMBEDDING_PROVIDER=openai
APP_PORT=8000
